								"operation": "notEmpty",
								"singleValue": true
							}
						},
						{
							"leftValue": "={{ $json.id_conversacion }}",
							"rightValue": "",
							"operator": {
								"type": "string",
								"operation": "notEmpty",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "b8000000-0000-4000-8000-000000000003",
			"name": "Message with Conversation?",
