				"resource": "callbackResponse",
				"operation": "send",
				"acciones": {
					"accion": [
						{
							"tipo": "sendText",
							"text": "={{ $json.output.message }}"
						},
						{
							"tipo": "teamDelegate",
							"id_team": ""
						}
					]
				},
				"autoInput": true,
				"respondWebhook": true
			},
			"id": "c1000000-0000-4000-8000-000000000009",
			"name": "Talk to an Advisor",
			"type": "n8n-nodes-liveconnect.liveConnect",
			"typeVersion": 1,
			"position": [
				1120,
				140
			]
		},
		{
			"parameters": {
				"resource": "callbackResponse",
				"operation": "send",
				"acciones": {
					"accion": [
						{
							"tipo": "sendText",
							"text": "={{ $json.output.message }}"
						},
						{
							"tipo": "addVar",
							"varname": "intencion",
							"varvalue": "agenda"
						},
						{
							"tipo": "input",
							"input": "What day and time work for you?"
						}
					]
				},
				"autoInput": true,
				"respondWebhook": true
			},
			"id": "c1000000-0000-4000-8000-00000000000a",
			"name": "Schedule Appointment",
			"type": "n8n-nodes-liveconnect.liveConnect",
			"typeVersion": 1,
			"position": [
				1120,
				320
