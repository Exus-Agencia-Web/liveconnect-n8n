{
	"name": "LiveConnect 03 — AI Chatbot",
	"nodes": [
		{
			"parameters": {
				"content": "## AI Chatbot on LiveConnect\n\n**Before activating:**\n1. Import and run workflow **01 — Configure the Proxy Webhook** pointing to this Webhook's Production URL.\n2. Set up the **OpenAI** credential on the model node.\n3. Set up the **LiveConnect API** credential on the response node.\n\n**Payload sent by LiveConnect** (real): `chat.id` (conversation ID), `chat.id_canal`, `chat.contacto` (id, nombre, celular…), `userInput` (this turn's message), and `inputs.mensaje_inicial` (first turn, when `userInput` arrives empty).\n\nThe agent's memory uses the conversation ID as the session key: each chat keeps its own history.",
				"height": 360,
				"width": 460
			},
			"id": "b3000000-0000-4000-8000-000000000001",
			"name": "Instructions",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				0,
				-220
			]
		},
		{
			"parameters": {
				"httpMethod": "POST",
				"path": "liveconnect-chatbot",
				"responseMode": "responseNode",
				"options": {}
			},
			"id": "b3000000-0000-4000-8000-000000000002",
			"name": "LiveConnect Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [
				520,
				60
			]
		},
		{
			"parameters": {
				"jsCode": "// Real LiveConnect payload: {chat, inputs, userInput, intent}\nconst raw = $input.first().json;\nconst body = raw.body ?? raw;\nconst chat = body.chat ?? {};\nconst inputs = body.inputs ?? {};\nconst message = String(body.userInput || inputs.mensaje_inicial || '').trim();\n\nreturn [{\n\tjson: {\n\t\tmessage,\n\t\tconversationId: String(chat.id ?? ''),\n\t\tchannelId: chat.id_canal ?? null,\n\t\tcontactId: chat.contacto?.id ?? null,\n\t\tcontactName: chat.contacto?.nombre || 'Customer',\n\t\tcontactPhone: chat.contacto?.celular || inputs.celular || '',\n\t},\n}];"
			},
			"id": "b3000000-0000-4000-8000-000000000003",
			"name": "Parse Message",
			"type": "n8n-nodes-base.code",
			"typeVersion": 2,
			"position": [
				740,
				60
			]
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "loose",
						"version": 2
					},
					"conditions": [
						{
							"leftValue": "={{ $json.message }}",
							"rightValue": "",
							"operator": {
								"type": "string",
								"operation": "notEmpty",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "b3000000-0000-4000-8000-000000000004",
			"name": "Is There a Message?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [
				960,
				60
			]
		},
		{
			"parameters": {
				"promptType": "define",
				"text": "={{ $json.message }}",
				"options": {
					"systemMessage": "You are the company's virtual assistant. You help customers by chat (WhatsApp and web) in English, with brief and friendly responses. The customer's name is {{ $json.contactName }}. If you do not know something, say so and offer to transfer them to a human agent. Never make up prices or data."
				}
			},
			"id": "b3000000-0000-4000-8000-000000000005",
			"name": "AI Agent",
			"type": "@n8n/n8n-nodes-langchain.agent",
			"typeVersion": 1.9,
			"position": [
				1180,
				40
			]
		},
		{
			"parameters": {
				"model": {
					"__rl": true,
					"value": "gpt-4o-mini",
					"mode": "list",
					"cachedResultName": "gpt-4o-mini"
				},
				"options": {}
			},
			"id": "b3000000-0000-4000-8000-000000000006",
			"name": "OpenAI Chat Model",
			"type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
			"typeVersion": 1.2,
			"position": [
				1120,
				280
			]
		},
		{
			"parameters": {
				"sessionIdType": "customKey",
				"sessionKey": "={{ $('Parse Message').first().json.conversationId }}"
			},
			"id": "b3000000-0000-4000-8000-000000000007",
			"name": "Conversation Memory",
			"type": "@n8n/n8n-nodes-langchain.memoryBufferWindow",
			"typeVersion": 1.3,
			"position": [
				1280,
				280
			]
		},
		{
			"parameters": {
				"resource": "proxy",
				"operation": "sendMessage",
				"id_conversacion": "={{ $('Parse Message').first().json.conversationId }}",
				"mensaje": "={{ $json.output }}"
			},
			"id": "b3000000-0000-4000-8000-000000000008",
			"name": "Reply to Customer",
			"type": "n8n-nodes-liveconnect.liveConnect",
			"typeVersion": 1,
			"position": [
				1520,
				40
			]
		},
		{
			"parameters": {
				"respondWith": "json",
				"responseBody": "{ \"ok\": true }",
				"options": {}
			},
			"id": "b3000000-0000-4000-8000-000000000009",
			"name": "Respond OK",
			"type": "n8n-nodes-base.respondToWebhook",
			"typeVersion": 1.1,
			"position": [
				1740,
				60
			]
		}
	],
