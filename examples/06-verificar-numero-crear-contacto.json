{
	"name": "LiveConnect 06 — Verify Number and Create Contact + Conversation",
	"nodes": [
		{
			"parameters": {
				"content": "## Validated WhatsApp contact signup\n\nReceives a form (webhook with `nombre` and `celular`), validates that the number exists on WhatsApp, creates the contact, opens a conversation, and sends the welcome message.\n\n**Configure:**\n- `id_canal` in **Verify Number** and **Create Conversation**: the ID of your WhatsApp QR channel (`Channel · Get Many`).\n- The `usuario` field of **Create Conversation**: `{ \"id_equipo\": <ID> }` assigns it to a team (`Team · Get Many`), or `{ \"id\": <ID>, \"nombre\": \"...\" }` to an agent.\n- The IF condition validates against the real response from `Check Number` — check one execution and adjust the field name if it differs.\n\nTest with: `curl -X POST <webhook-url> -H 'Content-Type: application/json' -d '{\"nombre\":\"Ana\",\"celular\":\"573001112233\"}'`",
				"height": 400,
				"width": 480
			},
			"id": "b6000000-0000-4000-8000-000000000001",
			"name": "Instructions",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [
				0,
				-260
			]
		},
		{
			"parameters": {
				"httpMethod": "POST",
				"path": "alta-contacto",
				"responseMode": "responseNode",
				"options": {}
			},
			"id": "b6000000-0000-4000-8000-000000000002",
			"name": "Signup Webhook",
			"type": "n8n-nodes-base.webhook",
			"typeVersion": 2,
			"position": [
				540,
				60
			]
		},
		{
			"parameters": {
				"resource": "whatsapp",
				"operation": "checkNumber",
				"id_canal": "",
				"numero": "={{ $json.body.celular }}"
			},
			"id": "b6000000-0000-4000-8000-000000000003",
			"name": "Verify Number",
			"type": "n8n-nodes-liveconnect.liveConnect",
			"typeVersion": 1,
			"position": [
				760,
				60
			]
		},
		{
			"parameters": {
				"conditions": {
					"options": {
						"caseSensitive": true,
						"leftValue": "",
						"typeValidation": "loose",
						"version": 2
					},
					"conditions": [
						{
							"leftValue": "={{ $json.existe ?? $json.exists ?? $json.valido ?? false }}",
							"rightValue": "true",
							"operator": {
								"type": "boolean",
								"operation": "true",
								"singleValue": true
							}
						}
					],
					"combinator": "and"
				},
				"options": {}
			},
			"id": "b6000000-0000-4000-8000-000000000004",
			"name": "Is the Number Valid?",
			"type": "n8n-nodes-base.if",
			"typeVersion": 2.2,
			"position": [
				980,
				60
			]
		},
		{
			"parameters": {
				"resource": "contact",
				"operation": "create",
				"nombre": "={{ $('Signup Webhook').first().json.body.nombre }}",
				"additionalFields": {
					"celular": "={{ $('Signup Webhook').first().json.body.celular }}"
				}
			},
			"id": "b6000000-0000-4000-8000-000000000005",
			"name": "Create Contact",
			"type": "n8n-nodes-liveconnect.liveConnect",
			"typeVersion": 1,
			"position": [
				1200,
				40
			]
		},
		{
			"parameters": {
				"resource": "conversation",
				"operation": "create",
				"id_canal": "",
				"contacto": "={{ { \"id\": $json.id } }}",
				"usuario": "={{ { \"id_equipo\": 0 } }}",
				"additionalFields": {}
			},
			"id": "b6000000-0000-4000-8000-000000000006",
			"name": "Create Conversation",
			"type": "n8n-nodes-liveconnect.liveConnect",
			"typeVersion": 1,
			"position": [
				1420,
				40
			]
		},
		{
			"parameters": {
				"resource": "proxy",
				"operation": "sendMessage",
				"id_conversacion": "={{ String($json.id ?? $json.id_conversacion) }}",
				"mensaje": "=Hello {{ $('Signup Webhook').first().json.body.nombre }}! 👋 Thanks for signing up. An advisor will assist you shortly."
			},
			"id": "b6000000-0000-4000-8000-000000000007",
			"name": "Welcome Message",
			"type": "n8n-nodes-liveconnect.liveConnect",
			"typeVersion": 1,
			"position": [
				1640,
				40
			]
		},
		{
			"parameters": {
				"respondWith": "json",
				"responseBody": "{ \"ok\": true, \"mensaje\": \"Contact created and welcome message sent\" }",
				"options": {}
			},
			"id": "b6000000-0000-4000-8000-000000000008",
			"name": "Respond OK",
			"type": "n8n-nodes-base.respondToWebhook",
			"typeVersion": 1.1,
			"position": [
				1860,
				60
			]
		},
		{
			"parameters": {
				"respondWith": "json",
				"responseBody": "{ \"ok\": false, \"error\": \"The number is not registered on WhatsApp\" }",
				"options": {}
			},
			"id": "b6000000-0000-4000-8000-000000000009",
			"name": "Respond Invalid Number",
			"type": "n8n-nodes-base.respondToWebhook",
			"typeVersion": 1.1,
			"position": [
				1200,
				220
			]
		}
	],
	"connections": {
		"Signup Webhook": {
			"main": [
				[
					{
						"node": "Verify Number",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Verify Number": {
			"main": [
				[
					{
						"node": "Is the Number Valid?",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Is the Number Valid?": {
			"main": [
				[
					{
						"node": "Create Contact",
						"type": "main",
						"index": 0
					}
				],
				[
					{
						"node": "Respond Invalid Number",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Create Contact": {
			"main": [
				[
					{
						"node": "Create Conversation",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Create Conversation": {
			"main": [
				[
					{
						"node": "Welcome Message",
						"type": "main",
						"index": 0
					}
				]
			]
		},
		"Welcome Message": {
			"main": [
				[
					{
						"node": "Respond OK",
						"type": "main",
						"index": 0
					}
				]
			]
		}
	},
	"settings": {
		"executionOrder": "v1"
	},
	"pinData": {},
	"meta": {
		"templateCredsSetupCompleted": false
	}
}
